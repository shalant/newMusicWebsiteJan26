<div id="header" class="@(_menuOpen ? "menu-open" : "")">
    <a href="#home" class="nav-brand" target="_top" aria-label="Doug Rosenberg — home">
        <img src="images/sax-nav-mark.png" alt="" class="sax-mark" />
    </a>
    <button class="hamburger" @onclick="ToggleMenu" aria-label="Toggle navigation" aria-expanded="@(_menuOpen ? "true" : "false")">
        <span></span>
        <span></span>
        <span></span>
    </button>
    <nav class="nav-links @(_menuOpen ? "open" : "")">
        <a href="#home" target="_top" @onclick="CloseMenu">home</a>
        <a href="#about" target="_top" @onclick="CloseMenu">about</a>
        <a href="#albums" target="_top" @onclick="CloseMenu">listen</a>
        <a href="#education" target="_top" @onclick="CloseMenu">education</a>
        <a href="#contact" target="_top" @onclick="CloseMenu">contact</a>
    </nav>
</div>

@code {
    private bool _menuOpen;
    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;
}
@inherits LayoutComponentBase

<ErrorBoundary>
    <ChildContent>
        <main id="main">
            @Body
        </main>
    </ChildContent>
    <ErrorContent Context="ex">
        <div class="app-crash">
            <div class="app-crash__eq">
                <span></span><span></span><span></span><span></span><span></span>
            </div>
            <h2 class="app-crash__title">Something went wrong</h2>
            <p class="app-crash__msg">@ex.Message</p>
            <button class="custom-cta-btn" onclick="window.location.reload()">Reload page</button>
        </div>
    </ErrorContent>
</ErrorBoundary>

<ThemeSwitcher />

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider @rendermode="RenderMode.InteractiveWebAssembly"/>
<MudSnackbarProvider />

<footer id="contact">
    @if (property is null)
    {
        <p class="footer-loading"><em>Loading…</em></p>
    }
    else
    {
        <div class="footer-brand">
            <p class="footer-name">@property.Name</p>
            @if (!string.IsNullOrWhiteSpace(property.Title))
            {
                <p class="footer-tagline">@property.Title</p>
            }
        </div>

        <div class="footer-rule"></div>

        @if (icons is not null)
        {
            <nav class="footer-social" aria-label="Social links">
                @if (!string.IsNullOrWhiteSpace(property.Email))
                {
                    <a href="mailto:@(property.Email)" class="footer-icon-link" aria-label="Email">
                        <img src="@icons.Email" alt="Email" class="social-icon" />
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(property.GitHub))
                {
                    <a href="https://github.com/@(property.GitHub)" target="_blank" rel="noopener noreferrer" class="footer-icon-link" aria-label="GitHub">
                        <img src="@icons.GitHub" alt="GitHub" class="social-icon" />
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(property.Instagram))
                {
                    <a href="https://instagram.com/@(property.Instagram)" target="_blank" rel="noopener noreferrer" class="footer-icon-link" aria-label="Instagram">
                        <img src="@icons.Instagram" alt="Instagram" class="social-icon" />
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(property.LinkedIn))
                {
                    <a href="https://linkedin.com/in/@(property.LinkedIn)" target="_blank" rel="noopener noreferrer" class="footer-icon-link" aria-label="LinkedIn">
                        <img src="@icons.LinkedIn" alt="LinkedIn" class="social-icon" />
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(property.Twitter))
                {
                    <a href="https://twitter.com/@(property.Twitter)" target="_blank" rel="noopener noreferrer" class="footer-icon-link" aria-label="Twitter / X">
                        <img src="@icons.Twitter" alt="Twitter" class="social-icon" />
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(property.YouTube))
                {
                    <a href="https://youtube.com/@(property.YouTube)" target="_blank" rel="noopener noreferrer" class="footer-icon-link" aria-label="YouTube">
                        <img src="@icons.YouTube" alt="YouTube" class="social-icon" />
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(property.Medium))
                {
                    <a href="https://medium.com/@@(property.Medium)" target="_blank" rel="noopener noreferrer" class="footer-icon-link" aria-label="Medium">
                        <img src="@icons.Medium" alt="Medium" class="social-icon" />
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(property.DevDotTo))
                {
                    <a href="https://dev.to/@(property.DevDotTo)" target="_blank" rel="noopener noreferrer" class="footer-icon-link" aria-label="Dev.to">
                        <img src="@icons.DevDotTo" alt="Dev.to" class="social-icon" />
                    </a>
                }
            </nav>
        }

        <div class="footer-meta">
            @if (!string.IsNullOrWhiteSpace(property.Email))
            {
                <a href="mailto:@(property.Email)" class="footer-email">@property.Email</a>
            }
            <p class="footer-credit">© @DateTime.Now.Year @property.Name</p>
        </div>
    }
</footer>

@code {
    [Parameter, EditorRequired]
    public required HttpClient Http { get; set; }

    [Parameter]
    public string PrimaryColor { get; set; } = string.Empty;

    [Parameter]
    public string SecondaryColor { get; set; } = string.Empty;

    private SiteProperties? property;
    private SocialIcons? icons;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            property = await Http.GetFromJsonAsync<SiteProperties>("sample-data/siteproperties.json");
            icons = await Http.GetFromJsonAsync<SocialIcons>("sample-data/socialicons.json");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Footer] Load failed: {ex.Message}");
        }
    }
}
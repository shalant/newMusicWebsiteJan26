<section class="light" id="albums">
    @if (hero is not null)
    {
        <img class="background" src="@(hero.Src)" alt="@(hero.Alt)" />
    }
    <h2 class="custom-mottled__header">
        Albums
    </h2>
    @if (albums is null || albums.Count == 0)
    {
        <p>No albums found.</p>
    }
    else
    {
        @for (int i = 0; i < albums.Count; i += 2)
        {
            <div class="row">
                <div class="col-md-6">
                    <div class="albums__glass-pane">
                        <img src="@albums[i].AlbumCoverUrl" alt="Album Cover" width="111" height="111" />
                        <a href="@albums[i].Url" target="_blank" rel="noopener noreferrer">
                            <h3 class="album__title">@albums[i].Title</h3>
                        </a>
                        <p class="small">@albums[i].Description</p>
                    </div>
                </div>
                @if (i + 1 < albums.Count)
                {
                    <div class="col-md-6">
                        <div class="albums__glass-pane">
                            <img src="@albums[i + 1].AlbumCoverUrl" alt="Album Cover" width="111" height="111" />
                            <a href="@albums[i + 1].Url" target="_blank" rel="noopener noreferrer">
                                <h3 class="album__title">@albums[i + 1].Title</h3>
                            </a>
                            <p class="small">@albums[i + 1].Description</p>
                        </div>
                    </div>
                }
            </div>
        }
    }
    
</section>

@code {
    [Parameter, EditorRequired]
    public required HttpClient Http { get; set; }

    [Parameter, EditorRequired]
    public required HeroImageService HeroImageService { get; set; }

    private List<Album>? albums;
    private HeroImage? hero;

    protected override async Task OnInitializedAsync()
    {
        albums = await Http.GetFromJsonAsync<List<Album>>("sample-data/albums.json");
        hero = await HeroImageService.GetHeroAsync(img => img.Name is "albums");
    }
}

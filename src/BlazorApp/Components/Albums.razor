<section class="light" id="albums">
    @if (hero is not null)
    {
        <img class="background" src="@(hero.Src)" alt="@(hero.Alt)" />
    }
    <h2 class="custom-mottled__header">Albums</h2>
    @if (albums is null || albums.Count == 0)
    {
        <p style="text-align:center">No albums found.</p>
    }
    else
    {
        <div class="albums-grid">
            @{ int idx = 0; }
            @foreach (var album in albums)
            {
                <div class="album-card reveal @(idx % 3 == 1 ? "reveal-delay-1" : idx % 3 == 2 ? "reveal-delay-2" : "")">
                    <div class="album-art-wrap">
                        <img src="@album.AlbumCoverUrl" alt="@album.Title" />
                        <div class="album-art-overlay">
                            <a href="@album.Url" target="_blank" rel="noopener noreferrer" class="album-listen-btn">Listen</a>
                        </div>
                    </div>
                    <div class="album-info">
                        <a href="@album.Url" target="_blank" rel="noopener noreferrer">
                            <h3 class="album__title">@album.Title</h3>
                        </a>
                        <p class="small">@album.Description</p>
                    </div>
                </div>
                idx++;
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public required HttpClient Http { get; set; }

    [Parameter, EditorRequired]
    public required HeroImageService HeroImageService { get; set; }

    private List<Album>? albums;
    private HeroImage? hero;

    protected override async Task OnInitializedAsync()
    {
        albums = await Http.GetFromJsonAsync<List<Album>>("sample-data/albums.json");
        hero = await HeroImageService.GetHeroAsync(img => img.Name is "albums");
    }
}

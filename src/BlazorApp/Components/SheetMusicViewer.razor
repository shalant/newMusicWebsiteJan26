<div class="sheet-music-viewer">
    <div class="sheet-music-selector">
        <h3>Sheet Music Library</h3>
        @if (sheetMusic is null || sheetMusic.Count == 0)
        {
            <p>Loading sheet music...</p>
        }
        else
        {
            <input class="sheet-music-search" type="text" placeholder="Search pieces..."
                   @bind-value="searchQuery" @bind-value:event="oninput" />
            <div class="sheet-music-list">
                @foreach (var (piece, idx) in FilteredMusic.Select((p, i) => (p, i)))
                {
                    <button class="sheet-music-item @(selectedIdx == idx ? "active" : "")"
                            @onclick="() => SelectSheetMusic(piece, idx)">
                        @piece.Title
                    </button>
                }
                @if (!FilteredMusic.Any())
                {
                    <p style="color: var(--text-secondary); font-size: 0.85rem; padding: 0.5rem 0;">No results.</p>
                }
            </div>
        }
    </div>

    <div class="sheet-music-display">
        @if (selectedMusic is not null)
        {
            <div class="pdf-viewer">
                <div class="pdf-controls">
                    <h4>@selectedMusic.Title</h4>
                    <a href="/sheetmusic/@selectedMusic.URL" target="_blank" rel="noopener noreferrer" class="pdf-link">
                        Open in New Tab
                    </a>
                </div>
                <iframe src="/sheetmusic/@selectedMusic.URL" type="application/pdf" class="pdf-frame"></iframe>
            </div>
        }
        else if (sheetMusic is not null && sheetMusic.Count > 0)
        {
            <div class="pdf-viewer-empty">
                <p>Select a piece from the list to view</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required HttpClient Http { get; set; }

    private List<SheetMusic>? sheetMusic;
    private SheetMusic? selectedMusic;
    private int selectedIdx = -1;
    private string searchQuery = string.Empty;

    private IEnumerable<SheetMusic> FilteredMusic =>
        sheetMusic?.Where(s =>
            string.IsNullOrWhiteSpace(searchQuery) ||
            s.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<SheetMusic>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sheetMusic = await Http.GetFromJsonAsync<List<SheetMusic>>("sample-data/sheetmusic.json");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[SheetMusicViewer] Load failed: {ex.Message}");
            sheetMusic = new List<SheetMusic>();
        }
    }

    private void SelectSheetMusic(SheetMusic piece, int idx)
    {
        selectedMusic = piece;
        selectedIdx = idx;
    }
}

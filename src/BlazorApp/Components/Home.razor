<section class="dark" id="home">
    @if (hero is not null)
    {
        <img class="background hero-image hero-overlay" src="@(hero.Src)" alt="@(hero.Alt)" />
    }
    <div class="custom-hero">
        @if (property is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <h1>@property.Name</h1>
            <h2>@property.Title</h2>
        }
    </div>
    <div class="scroll-anchor">
        <a href="#about" target="_top">
            <img class="scroll-anchor__img" src="images/down-arrow.svg" alt="scroll down" />
        </a>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required HttpClient Http { get; set; }

    [Parameter, EditorRequired]
    public required HeroImageService HeroImageService { get; set; }

    private SiteProperties? property;
    private HeroImage? hero;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            property = await Http.GetFromJsonAsync<SiteProperties>("sample-data/siteproperties.json");
            hero = await HeroImageService.GetHeroAsync(img => img.Name is "home");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[Home] Load failed: {ex.Message}");
        }
    }
}

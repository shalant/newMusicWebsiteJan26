<section class="light" id="education">
    <h2>Portfolio</h2>
    <h4>Selected Value: @SelectedSheetMusic?.Title  </h4>
    <h4>Song Value: @SongValue </h4>
    <div>
        @* <select class="form-control" @onchange="@((args)=>OpenSheetMusic(args, SongValue))"> *@
        <select class="form-control"">
            <option value="-1">Select an song!</option>
            @foreach (var item in SheetMusics)
            {
                <option value="@item.Id" @onclick="()=>SongValue=item.Id">@item.Title</option>
            }
        </select>
    </div>
</section>

@code {
    [Inject]
    NavigationManager NavigationManager { get; set; } = default!;

    [Parameter, EditorRequired]
    public required HttpClient Http { get; set; }

    [Parameter, EditorRequired]
    public required HeroImageService HeroImageService { get; set; }

    private string _value;
    private int SongValue { get; set; } = 0;

    private List<SheetMusic>? musicalSheets;
    private HeroImage? hero;

    public string SelectedSheetMusicString { get; set; } = "test";
    public SheetMusic? SelectedSheetMusic { get; set; }
    public int? SelectedSheetMusicId { get; set; }
    public List<SheetMusic> SheetMusics { get; set; } = new List<SheetMusic>();

    private readonly string[] _states =
    {
        "Alabama", "Alaska", "Arizona", "Arkansas", "California",
        "Colorado", "Connecticut", "Delaware", "Florida", "Georgia",
        "Hawaii", "Idaho", "Illinois", "Indiana", "Iowa", "Kansas",
        "Kentucky", "Louisiana", "Maine", "Maryland", "Massachusetts",
        "Michigan", "Minnesota", "Mississippi", "Missouri", "Montana",
        "Nebraska", "Nevada", "New Hampshire", "New Jersey", "New Mexico",
        "New York", "North Carolina", "North Dakota", "Ohio", "Oklahoma",
        "Oregon", "Pennsylvania", "Rhode Island", "South Carolina", "South Dakota",
        "Tennessee", "Texas", "Utah", "Vermont", "Virginia",
        "Washington", "West Virginia", "Wisconsin", "Wyoming"
    };

    protected override async Task OnInitializedAsync()
    {
        musicalSheets = await Http.GetFromJsonAsync<List<SheetMusic>>("sample-data/sheetmusic.json");
        hero = await HeroImageService.GetHeroAsync(img => img.Name is "portfolio");

        SheetMusics = new List<SheetMusic>
        {
            new SheetMusic { Id = 1, Title = "Fur Elise", URL = "Ludwig van Beethoven" },
            new SheetMusic { Id = 2, Title = "Moonlight Sonata", URL = "Ludwig van Beethoven" },
            new SheetMusic { Id = 3, Title = "Clair de Lune", URL = "Claude Debussy" }
        };
    }

    protected void OpenSheetMusic(ChangeEventArgs e, int songValue)
    {
        Console.WriteLine($"{songValue}");

        // NavigationManager.NavigateTo($"https://www.google.com/{songValue}");
    }
}





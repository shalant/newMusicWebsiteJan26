                    <li><strong>New England Conservatory</strong> — Bachelor of Music, Jazz Performance (1997–2002)</li>
                    <li><strong>BS in Chemistry</strong> (1997–2002)</li>
                </ul>
            </div>
        </div>
    </div>
</section>




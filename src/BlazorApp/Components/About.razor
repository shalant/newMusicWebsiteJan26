<section class="light" id="about">
    @if (hero is not null)
    {
        <img class="background" src="@(hero.Src)" alt="@(hero.Alt)" />
    }
    <h2>About Myself</h2>
    <div class="custom-glass-pane reveal">
        @if (aboutMe is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <p class="large">@aboutMe.Description</p>
            <hr />
            <ul class="skills-list">
                @foreach (var skill in aboutMe.Skills)
                {
                    <li key="@skill">@skill</li>
                }
            </ul>
            <hr />
            <p class="detail-quote">@aboutMe.DetailOrQuote</p>
        }
    </div>

    <section>
        <h2 class="custom-mottled__header reveal">Performance Experience</h2>

        <!-- Animated stat counters -->
        <div class="perf-stats reveal">
            <div class="perf-stat">
                <span class="perf-stat__number" data-count="6">6</span>
                <span class="perf-stat__label">Chicago Venues</span>
            </div>
            <div class="perf-stat">
                <span class="perf-stat__number" data-count="14">14</span>
                <span class="perf-stat__label">National &amp; International</span>
            </div>
            <div class="perf-stat">
                <span class="perf-stat__number" data-count="34">34</span>
                <span class="perf-stat__label">Artists Performed With</span>
            </div>
        </div>

        <!-- Venues - hip list layout -->
        <div class="perf-venues-grid reveal">
            <div class="perf-venue-group">
                <div class="perf-venue-group__header">
                    <span class="perf-venue-group__label">Chicago</span>
                </div>
                <ul class="perf-venue-list">
                    <li>Millennium Park</li>
                    <li>Green Mill</li>
                    <li>Hothouse</li>
                    <li>Symphony Center</li>
                    <li>Jazz Showcase</li>
                    <li>Taste of Chicago</li>
                </ul>
            </div>
            <div class="perf-venue-group">
                <div class="perf-venue-group__header">
                    <span class="perf-venue-group__label">National &amp; International</span>
                </div>
                <ul class="perf-venue-list perf-venue-list--two-col">
                    <li>Joe's Pub</li>
                    <li>St. Louis Art Museum</li>
                    <li>Knitting Factory</li>
                    <li>Chris' Jazz Café</li>
                    <li>Blues Alley</li>
                    <li>Makor</li>
                    <li>Satalla</li>
                    <li>Firefly Club</li>
                    <li>Cedar Cultural Center</li>
                    <li>Johnny D's</li>
                    <li>Canadian Guitar Festival</li>
                    <li>Alchemia</li>
                    <li>Krannert Center</li>
                    <li>Dazzle</li>
                </ul>
            </div>
        </div>
        <div class="custom-glass-pane reveal">
            <h3>Artists Performed With</h3>
            <div class="perf-artists-grid">
                <span>Sam Barsh</span><span>Brendan Bayliss</span><span>Bobby Broom</span>
                <span>Maggie Brown</span><span>Maurice Brown</span><span>Oscar Brown Jr.</span>
                <span>Phil Cohran</span><span>Ernest Dawkins</span><span>Michael Franti</span>
                <span>George Freeman</span><span>Robert Glasper</span><span>Fareed Haque</span>
                <span>Nikki Glaspie</span><span>Jen Hartswick</span><span>Keyon Harrold</span>
                <span>Marquis Hill</span><span>Robert "Baabe" Irving III</span>
                <span>Goran Ivanovic</span><span>Karsh Kale</span><span>Mark Kelley</span>
                <span>Rakalam Bob Moses</span><span>Kris Myers</span><span>Jeff Parker</span>
                <span>Danilo Pérez</span><span>Joe Russo</span><span>Kendrick Scott</span>
                <span>Sherry Scott</span><span>John Sinclair</span><span>Walter Smith</span>
                <span>Oscar Stagnaro</span><span>Luciana Souza</span><span>Matt Ulery</span>
                <span>Corey Wilkes</span><span>David Young</span>
            </div>
        </div>
    </section>
</section>

@code {
    [Parameter, EditorRequired]
    public required HttpClient Http { get; set; }

    [Parameter, EditorRequired]
    public required HeroImageService HeroImageService { get; set; }

    private AboutMe? aboutMe;
    private HeroImage? hero;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            aboutMe = await Http.GetFromJsonAsync<AboutMe>("sample-data/aboutme.json");
            hero = await HeroImageService.GetHeroAsync(img => img.Name is "about");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[About] Load failed: {ex.Message}");
        }
    }
}

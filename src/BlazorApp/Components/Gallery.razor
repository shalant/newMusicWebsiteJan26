<section class="light" id="gallery">
    <h2 class="custom-mottled__header reveal">Photo Gallery</h2>

    @if (photos is null)
    {
        <p class="gallery-loading">Loading gallery…</p>
    }
    else
    {
        <!-- Category filter tabs -->
        <div class="gallery-filters reveal">
            <button class="gallery-filter @(activeCategory == null ? "gallery-filter--active" : "")"
                    @onclick='() => activeCategory = null'>All</button>
            @foreach (var cat in Categories)
            {
                <button class="gallery-filter @(activeCategory == cat ? "gallery-filter--active" : "")"
                        @onclick="() => activeCategory = cat">@cat</button>
            }
        </div>

        <div class="gallery-grid">
            @foreach (var (photo, idx) in FilteredPhotos.Select((p, i) => (p, i)))
            {
                var originalIdx = photos.IndexOf(photo);
                <div class="gallery-card reveal" @onclick="() => OpenLightbox(originalIdx)">
                    <img src="@photo.Src" alt="@photo.Caption" loading="lazy" />
                    <div class="gallery-card__overlay">
                        <div class="gallery-card__zoom">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white"
                                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"/>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                                <line x1="11" y1="8" x2="11" y2="14"/>
                                <line x1="8" y1="11" x2="14" y2="11"/>
                            </svg>
                        </div>
                        <div class="gallery-card__info">
                            <p class="gallery-card__caption">@photo.Caption</p>
                            @if (!string.IsNullOrWhiteSpace(photo.Category))
                            {
                                <span class="gallery-card__category">@photo.Category</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Lightbox -->
    @if (lightboxOpen && photos is not null)
    {
        <div class="gallery-lightbox" @onclick="CloseLightbox"
             @onkeydown="HandleKey" tabindex="-1" @ref="lightboxRef">

            <!-- Close -->
            <button class="gallery-lightbox__close" aria-label="Close"
                    @onclick:stopPropagation="true" @onclick="CloseLightbox">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>

            <!-- Counter -->
            <span class="gallery-lightbox__counter">@(currentIdx + 1) / @photos.Count</span>

            <!-- Prev -->
            <button class="gallery-lightbox__prev" aria-label="Previous photo"
                    @onclick:stopPropagation="true" @onclick="PrevPhoto">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </button>

            <!-- Image + caption -->
            <div class="gallery-lightbox__content" @onclick:stopPropagation="true">
                <img src="@photos[currentIdx].Src" alt="@photos[currentIdx].Caption" />
                <p class="gallery-lightbox__caption">@photos[currentIdx].Caption</p>
                @if (!string.IsNullOrWhiteSpace(photos[currentIdx].Category))
                {
                    <span class="gallery-lightbox__cat">@photos[currentIdx].Category</span>
                }
            </div>

            <!-- Next -->
            <button class="gallery-lightbox__next" aria-label="Next photo"
                    @onclick:stopPropagation="true" @onclick="NextPhoto">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </button>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public required HttpClient Http { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private List<GalleryPhoto>? photos;
    private bool lightboxOpen = false;
    private int currentIdx = 0;
    private string? activeCategory = null;
    private ElementReference lightboxRef;

    private IEnumerable<string> Categories =>
        photos?.Select(p => p.Category)
              .Where(c => !string.IsNullOrWhiteSpace(c))
              .Distinct() ?? Enumerable.Empty<string>();

    private IEnumerable<GalleryPhoto> FilteredPhotos =>
        activeCategory is null
            ? (photos ?? Enumerable.Empty<GalleryPhoto>())
            : (photos ?? Enumerable.Empty<GalleryPhoto>())
                .Where(p => p.Category == activeCategory);

    protected override async Task OnInitializedAsync()
    {
        photos = await Http.GetFromJsonAsync<List<GalleryPhoto>>("sample-data/gallery.json");
    }

    private async Task OpenLightbox(int idx)
    {
        lightboxOpen = true;
        currentIdx = idx;
        StateHasChanged();
        await Task.Delay(50);
        try { await lightboxRef.FocusAsync(); } catch { }
    }

    private void CloseLightbox() => lightboxOpen = false;

    private void PrevPhoto()
    {
        if (photos is not null)
            currentIdx = (currentIdx - 1 + photos.Count) % photos.Count;
    }

    private void NextPhoto()
    {
        if (photos is not null)
            currentIdx = (currentIdx + 1) % photos.Count;
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseLightbox();
        else if (e.Key == "ArrowLeft") PrevPhoto();
        else if (e.Key == "ArrowRight") NextPhoto();
    }
}
